<!DOCTYPE html>
<html>
  <head>
    <% if (htmlWebpackPlugin.options.gtm_id) { %>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl+'<%= htmlWebpackPlugin.options.gtm_env_auth %>';
        f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%- htmlWebpackPlugin.options.gtm_id %>');
    </script>
    <!-- End Google Tag Manager -->
    <% } %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="google" value="notranslate">
    <!-- Fase 5 — sin esto, todos los assets con URL relativa (gui.js, favicon, etc.) resuelven
         contra el path actual del navegador en vez de la raíz del sitio. No se notaba antes
         porque el único path real era "/"; se rompe en cuanto existe una ruta como /jugar/:id
         servida por el fallback de SPA (mismo archivo index.html, distinto pathname). -->
    <base href="/">
    <link rel="shortcut icon" href="static/favicon.ico">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <!-- 28/11/2026 — pantalla de carga. gui.js pesa ~5,5 MB comprimido (19 MB sin comprimir) y hasta que
         baja el body estaba vacío: en el wifi del aula o con datos del celular se veía una pantalla
         blanca varios segundos y parecía roto. Es HTML+CSS puro (se pinta sin esperar al JS) y
         index.jsx la quita apenas monta la app. A los 20 s sin cargar muestra un aviso para recargar. -->
    <style>
      #boot-splash{position:fixed;top:0;right:0;bottom:0;left:0;z-index:2147483647;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#0F1629;color:#fff;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;text-align:center;padding:16px}
      #boot-splash .bs-spin{width:44px;height:44px;border:4px solid rgba(255,255,255,.2);border-top-color:#F5C518;border-radius:50%;animation:bs-rot .9s linear infinite}
      #boot-splash .bs-title{margin:20px 0 0;font-size:18px;font-weight:700}
      #boot-splash .bs-sub{margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.7)}
      #boot-splash .bs-slow{margin:20px 0 0;font-size:14px;color:#F5C518;opacity:0;animation:bs-show .3s ease 20s forwards}
      @keyframes bs-rot{to{transform:rotate(360deg)}}
      @keyframes bs-show{to{opacity:1}}
      @media (prefers-reduced-motion:reduce){#boot-splash .bs-spin{animation-duration:3s}}
    </style>
  </head>
  <body>
    <div id="boot-splash" role="status" aria-live="polite">
      <div class="bs-spin"></div>
      <p class="bs-title">Coders Academy</p>
      <p class="bs-sub">Cargando el editor…</p>
      <p class="bs-slow">Está tardando más de lo normal. Si no abre, recargá la página.</p>
    </div>
    <noscript><p style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483647;margin:0;padding:24px;background:#0F1629;color:#fff;font-family:system-ui,sans-serif">Este editor necesita JavaScript activado para funcionar.</p></noscript>
    <% if (htmlWebpackPlugin.options.gtm_id) { %>
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%- htmlWebpackPlugin.options.gtm_id %><%= htmlWebpackPlugin.options.gtm_env_auth %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->
    <% } %>
  </body>
</html>
